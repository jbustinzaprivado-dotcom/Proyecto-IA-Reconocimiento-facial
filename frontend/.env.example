# Dirección del backend (FastAPI), sin barra final.
# En desarrollo local: http://localhost:8000
# En Vercel: define esta variable en el proyecto ANTES de compilar (Settings > Environment Variables),
# por ejemplo https://mi-api.onrender.com. Sin ella, `npm run build` se detiene con un aviso.
VITE_API_URL=http://localhost:8000

# Datos simulados sin backend. Solo existen en desarrollo (npm run dev): en una compilación para un
# servidor no tienen ningún efecto, y sus datos no se incluyen en los archivos publicados.
VITE_USE_MOCKS=false
