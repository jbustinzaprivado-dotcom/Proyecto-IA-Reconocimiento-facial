# Copia este archivo como .env y ajusta los valores. El .env real NO se versiona.

# Base de datos. SQLite en desarrollo; Postgres o Supabase en la demo publicada, por ejemplo:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@servidor:5432/basedatos
DATABASE_URL=sqlite:///./dev.db

# Motor facial: insightface (por defecto), sface o simulated (solo pruebas, NO reconoce rostros).
# Los pesos se bajan con: python -m app.scripts.download_models
FACE_ENGINE=insightface

# Paquete de modelos de InsightFace y carpeta de los pesos (relativa a backend/)
INSIGHTFACE_MODEL=buffalo_l
MODELS_DIR=models

# Umbral de similitud para aceptar una coincidencia (0 a 1). Si se deja vacío, cada motor usa el
# suyo (simulado 0.75, SFace 0.363, InsightFace 0.40). Los de SFace y InsightFace son provisionales:
# cada modelo tiene su propia escala y hay que calibrarlo con datos reales
# RECOGNITION_THRESHOLD=0.4

# Cuánto por encima del umbral tiene que estar la similitud de una coincidencia para que su
# confianza sea "alta" (0 a 1). Menos que eso y sigue coincidiendo, es "media"; si no coincide,
# es "baja". Es una regla sobre la distancia al umbral, no una probabilidad
CONFIDENCE_MARGIN=0.10

# Entrenar el modelo de probabilidad desde la página "Entrenamiento ML". Viene APAGADO: entrenar
# cambia lo que muestran todos los reconocimientos siguientes y la API no tiene login hasta la
# Fase 5. Enciéndelo solo cuando vayas a entrenar y reinicia la API
ML_TRAINING_ENABLED=false

# Direcciones del frontend permitidas por CORS, separadas por comas. Si Vite usa otro puerto
# (por ejemplo 5174 porque el 5173 está ocupado), agrégalo aquí: sin eso el navegador bloquea
# las peticiones y el frontend muestra "No se pudo conectar con el servidor"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Límites de las imágenes que se suben al registrar una persona
MAX_IMAGES_PER_PERSON=5
MAX_IMAGE_BYTES=5242880
